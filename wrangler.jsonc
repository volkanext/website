{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-10-17",
  "previews": {},
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}