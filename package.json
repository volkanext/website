{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-og-image.mjs && vite build && vite build --ssr src/ssr/prerender.ts --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-a11y.mjs",
    "lint": "eslint .",
    "check:a11y": "node scripts/check-a11y.mjs",
    "preview": "vite preview",
    "generate:og": "node scripts/generate-og-image.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "^0.35.5",
